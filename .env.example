# Copy to .env (gitignored) for local runs, or set the same names in the hosting
# dashboard. The service falls back to a local SQLite file when no Postgres URL
# is set, so only the first two entries are needed for a deployment.

# Postgres. Any Postgres 15+ works; Neon's pooled URL and Supabase's session
# pooler URL are both fine. IDX_DATABASE_URL wins over DATABASE_URL.
IDX_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret for /api/v1/cron/refresh. Required there: without it the
# endpoint refuses to run instead of exposing a public trigger. On Vercel the
# cron invocation arrives as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me

# Paths, for a deployment that does not ship them at the default locations.
# IDX_ARTIFACT_DIR=/app/models
# IDX_RESEARCH_DATA_DIR=/app/data/research

# Scheduler slots in WIB (UTC+7) and the revisits policy. The slots say when a
# run is due; an external cron decides when to check.
# IDX_SCHEDULE_TIMES=16:05,18:00
# IDX_SCHEDULE_DAYS=mon,tue,wed,thu,fri
# IDX_SCHEDULE_SYMBOLS=ADRO,ANTM,BMRI,BNGA,EXCL,INCO,INKP,MEDC,PGAS,TLKM
# IDX_SCHEDULE_RETRY_ATTEMPTS=2
# IDX_SCHEDULE_RETRY_DELAY_SECONDS=300

# Retraining. 0 keeps the API from running jobs itself, for a separate
# `idx_signal.cli train-worker` process.
# IDX_TRAINING_EPOCHS=10
# IDX_TRAINING_INLINE=1
# IDX_TRAINING_DIR=data/trained
