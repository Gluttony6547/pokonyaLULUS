FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KERAS_BACKEND=torch

WORKDIR /app

COPY requirements.txt requirements-torch-cpu.txt ./
RUN pip install --no-cache-dir -r requirements-torch-cpu.txt \
    && pip install --no-cache-dir -r requirements.txt \
    && python -c "import torch; assert torch.version.cuda is None"

COPY backend_api.py data_pipeline.py database.py market_data.py model_service.py models.py schemas.py ./
COPY models/ ./models/
COPY data/research/ ./data/research/
COPY static/ ./static/

EXPOSE 80

CMD ["sh", "-c", "uvicorn backend_api:app --host 0.0.0.0 --port ${PORT:-80}"]
